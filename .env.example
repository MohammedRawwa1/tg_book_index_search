ATLAS_SEARCH_FUZZY=true
BACKFILL_AUTO=false
BACKFILL_CHAT_IDS=-1001111111111,-1002222222222
BACKFILL_INTERVAL_SECONDS=3600
BOOK_INDEX_FOLDER=/data/book-index
BOT_TOKEN=123456:ABCDEF123456
DB_NAME=book_indexer
DELETE_COMMANDS=false
DIAG_SECRET=change-me
ENABLE_ATLAS_SEARCH=true
ENRICH_DEBUG=false
INDEX_VIDEO=false
LOGS_CHANNEL=-1003333333333
LOG_LEVEL=INFO
MAX_LINKS_PER_PAGE=20
MAX_MSG=1000
MAX_QUERY_LEN=100
MONGODB_NAME=book_indexer
MONGO_ALLOW_LAZY=true
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_URI=mongodb://localhost:27017
OWNER_ID=123456789
PORT=8080
RANK_CANDIDATE_LIMIT=20
RANK_CODEC_WEIGHT=1.0
RANK_FILENAME_MATCH=2.0
RANK_FNAME_LEN_PENALTY_DIV=4.0
RANK_PREFIX_BOOST=1.5
RANK_QUALITY_WEIGHT=3.0
RANK_RECENCY_WEIGHT=0.5
RANK_TITLE_WEIGHT=4.0
RANK_TRIGRAM_WEIGHT=2.5
RANK_YEAR_WEIGHT=1.0
RUN_BOT_IN_API=true
SEARCH_COOLDOWN=3
SEARCH_STREAM_URL=https://example.com/stream
SESSION_ENC_KEY=replace-with-random-secret
SESSION_STRING=1:ABCDEF123456
SKIP_SENDER_CHAT=true
TARGET_CHAT_ID=-1004444444444
TELEGRAPH_API_TOKEN=your-telegraph-token
TELEGRAPH_DB=book-index
TELETHON_API_HASH=your-telethon-api-hash
TELETHON_API_ID=123456

# On-demand by design: no pinger, no keep-warm loop. Render wakes a Free instance
# on the next inbound request (~1 min), and Telegram retries the delivery that
# provoked it, so the bot is late rather than deaf. Keeping it warm instead would
# use ~730 of the 750 instance-hours a workspace gets per month and suspend every
# Free service once that runs out. See docs/ON_DEMAND.md.

# Guards GET /status, which reports the webhook Telegram is delivering to and
# its last delivery error. Unset = the endpoint answers 404.
STATUS_TOKEN=change-me

# Diagnostic scripts (read-only env vars; no chat ids or group names are
# stored in this repo)
CHECK_CHAT_IDS=-1001234567890
QUERY_CHAT_ID=-1001234567890
DIAG_TARGET_CHAT_ID=-1001234567890
DIAG_TARGET_TITLE=
DIAG_SEARCH_TEXT=
